{
  "name": "seefore",
  "version": "0.0.0",
  "private": true,
  "description": "Software architecture kept as YAML files, shown as a page on this machine.",
  "type": "module",
  "bin": {
    "seefore": "bin/seefore.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "types": "tsc --noEmit -p src/model && tsc --noEmit -p src/server && tsc --noEmit -p src/ui",
    "test": "vitest run",
    "build": "vite build",
    "check": "node scripts/check.ts",
    "schema": "node scripts/schema.ts",
    "dev": "node scripts/dev.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@xyflow/react": "13.0.3",
    "elkjs": "0.12.1",
    "lucide-react": "0.564.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
