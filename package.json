{
  "name": "seefore-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p packages/cli",
    "test": "vitest run",
    "build": "npm run build --workspace seefore",
    "check": "npm run typecheck && npm run build && npm run test",
    "install:local": "npm run build && node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
